{
  "name": "xiangkou-huashipu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "balance": "node scripts/check-balance.mjs",
    "requirements": "node scripts/check-requirements.mjs",
    "loop": "node scripts/check-gameplay-loop.mjs",
    "autoplay": "node scripts/check-autoplay.mjs",
    "domain:parity": "node scripts/check-domain-parity.mjs",
    "ui:mobile": "playwright test",
    "ui:cocos": "playwright test -c playwright.cocos.config.ts",
    "wechat:build:web": "node scripts/build-cocos.mjs web-mobile",
    "wechat:build": "node scripts/build-cocos.mjs wechatgame",
    "wechat:build:all": "node scripts/build-cocos.mjs all",
    "wechat:meta": "node scripts/repair-cocos-meta.mjs",
    "wechat:configure": "node scripts/configure-wechat-build.mjs",
    "wechat:preview": "python3 -m http.server 4180 --bind 127.0.0.1 --directory wechat-client/build/web-mobile",
    "pages:prepare": "npm run build && node scripts/prepare-pages.mjs",
    "wechat:domain": "node scripts/check-wechat-domain.mjs",
    "wechat:autoplay": "node scripts/check-autoplay.mjs --cocos --target=all",
    "wechat:cloud": "node scripts/check-wechat-cloud.mjs",
    "wechat:ui": "node scripts/check-cocos-ui.mjs",
    "wechat:check": "node scripts/check-wechat-client.mjs",
    "verify": "npm run build && npm run balance && npm run requirements && npm run loop && npm run autoplay && npm run domain:parity && npm run ui:mobile && npm run wechat:domain && npm run wechat:autoplay && npm run wechat:cloud && npm run wechat:ui",
    "verify:local": "npm run verify && npm run wechat:build:web && npm run ui:cocos && npm run wechat:build && npm run wechat:check"
  },
  "dependencies": {
    "@vitejs/plugin-legacy": "^7.2.1",
    "vite": "^7.0.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
